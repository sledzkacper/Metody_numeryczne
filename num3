
u = []
Diagonala = []
l = []

b = []

N = 4   # Podajemy rozmiar macierzy

for i in range (1,N + 1):

    """Pętla na górną diagonalę u"""
    u.append(0.1/i)
    
    """Pętla na diagonalę"""
    Diagonala.append(1.012)

    """Pętla na dolną diagonalę l"""
    l.append(0.145 / (i ** 2))

    """Pętla na wektor b"""
    b.append((i ** 0.5))

print("diag. góra: ", u)
print("diag. glowna: ", Diagonala)
print("diag. dol: ", l)
print("b: ", b)

for i in range (1, N):
    """Rozkład LU"""
    l[i] = l[i] / Diagonala[i - 1]
    Diagonala[i] = 1.012 - u[i - 1] * l[i - 1]

print("Diagonala po rozkładzie: ", Diagonala)
print("Dolna diag. po rozkładzie: ", l)

detA = 1    # Liczymy wyznacznik macierzy A
for i in Diagonala:
    detA *= i

print("detA = ", detA)

