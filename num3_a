
u = []
Diagonala = []
l = []

b = []

N = 4   # Podajemy rozmiar macierzy

for i in range (1,N + 1):

    """Pętla na górną diagonalę u"""
    if i < N:
        u.append(0.1/i)
    
    """Pętla na diagonalę"""
    Diagonala.append(1.012)

    """Pętla na dolną diagonalę l"""
    if i < N:
        l.append(0.145 / (i ** 2))

    """Pętla na wektor b"""
    b.append((i ** 0.5))

print("diag. góra: ", u)
print("diag. glowna: ", Diagonala)
print("diag. dol: ", l)
print("b: ", b)

for i in range (1, N):
    """Rozkład LU"""
    if i < (N - 1):
        l[i] = l[i] / Diagonala[i - 1]

    Diagonala[i] = 1.012 - u[i - 1] * l[i - 1]

print("Diagonala po rozkładzie: ", Diagonala)
print("Dolna diag. po rozkładzie: ", l)

detA = 1    # Liczymy wyznacznik macierzy A
for i in Diagonala:
    detA *= i

print("detA = ", detA)

# a) Obliczanie Ax = b
y = [0] * N
y[0] = b[0]
for i in range (1, N):
    """ ly = b"""
    y[i] = b[i] - y[i - 1] * l[i-1] # l[i - 1] zamiast l[i], ponieważ w liście l jest o jeden mniej wyraz niż na diagonali. To samo z górną wstęgą u.

print("Wektor y: ", y)

x = [0] * N

for i in reversed(range(N)):
        """ ux = y"""
        if i == N - 1:
            x[i] = y[i] / Diagonala[i]
        else:
            x[i] = (y[i] - u[i] * x[i + 1]) / Diagonala[i]

print("Wektor x: ", x)


