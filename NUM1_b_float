import numpy as np
import matplotlib.pyplot as plt

# Funkcja i jej pochodna ---
def f(x):
    return np.log(x) * np.sin(x)

def f_prime_exact(x):
    return np.sin(x)/x + np.log(x)*np.cos(x)

# Punkt obliczeń
x0 = np.float32(0.5)

# Zakres h (kroki)
h = np.logspace(-7, -1, 200, dtype=np.float32)  # float32 ma sensowny zakres do 10^-7

# Przybliżenie różnicą centralną
D = (f(x0 + h) - f(x0 - h)) / (2 * h)

# Rzeczywista pochodna
f_exact = np.float32(f_prime_exact(x0))

# Wzór na funkkcję E(h)
E_h = np.abs(D - f_exact)

# Wykres
plt.figure(figsize=(8,6))
plt.loglog(h, E_h, 'b-', label='Central difference, float')
plt.xlabel('h')
plt.ylabel('E(h) = |Dhf(x) - f′(x)|')
plt.title('Błąd numeryczny przybliżenia pochodnej - Central difference')
plt.grid(True, which='both')
plt.legend()
plt.show()

# Trzecia pochodna (dla h*)
def f_third(x):
    # f'''(x) = (-3*sin(x)/x^3) + (6*cos(x)/x^2) - (3*sin(x)/x) - log(x)*cos(x)
    return (-3*np.sin(x)/x**3) + (6*np.cos(x)/x**2) - (3*np.sin(x)/x) - np.log(x)*np.cos(x)

# Epsilon maszynowy dla float
eps = np.finfo(np.float32).eps  # ≈ 1.19e-07

# Wzór na optymalne h*
h_opt = (3 * abs(f(x0)) * eps / abs(f_third(x0))) ** (1/3)

print(f"h* = {h_opt:.3e}")
